{
  "name": "vane-workbench",
  "displayName": "Vane Workbench",
  "description": "Cursor-like Agent chat for crypto repos, plus Wallets/Transactions placeholders.",
  "version": "0.2.0",
  "publisher": "vane",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other", "Machine Learning"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension",
  "scripts": {
    "compile": "gulp compile-extension:vane-workbench",
    "watch": "gulp watch-extension:vane-workbench"
  },
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "contributes": {
    "configuration": {
      "title": "Vane",
      "properties": {
        "vane.operatingMode": {
          "type": "string",
          "default": "code_only",
          "enum": ["code_only", "simulation", "testnet", "live"],
          "enumDescriptions": [
            "Edit and run tools without chain writes",
            "Fork / simulate only",
            "Testnet broadcast after approval",
            "Mainnet — user UI only; AI cannot enable"
          ],
          "description": "Operating mode. Live must never be enabled by the agent."
        },
        "vane.agent.provider": {
          "type": "string",
          "default": "openai",
          "enum": ["openai", "anthropic"],
          "description": "Model provider for the Agent panel."
        },
        "vane.agent.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Model id (e.g. gpt-4o-mini, claude-sonnet-4-20250514)."
        },
        "vane.agent.autoRunSafeTools": {
          "type": "boolean",
          "default": true,
          "description": "Auto-run read/search tools. Writes and terminal still ask for approval."
        },
        "vane.placeholderChain": {
          "type": "string",
          "default": "Base Sepolia",
          "description": "Placeholder chain label for the status bar."
        },
        "vane.placeholderWallet": {
          "type": "string",
          "default": "None",
          "description": "Placeholder wallet label (no vault yet)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vane",
          "title": "Vane",
          "icon": "$(rocket)"
        }
      ]
    },
    "views": {
      "vane": [
        {
          "type": "webview",
          "id": "vane.agent",
          "name": "Agent",
          "contextualTitle": "Vane Agent"
        },
        {
          "id": "vane.wallets",
          "name": "Wallets"
        },
        {
          "id": "vane.transactions",
          "name": "Transactions"
        }
      ]
    },
    "commands": [
      {
        "command": "vane.openAgent",
        "title": "Vane: Open Agent",
        "category": "Vane",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "vane.openWallets",
        "title": "Vane: Open Wallets",
        "category": "Vane"
      },
      {
        "command": "vane.openTransactions",
        "title": "Vane: Open Transactions",
        "category": "Vane"
      },
      {
        "command": "vane.showMode",
        "title": "Vane: Show Operating Mode",
        "category": "Vane"
      },
      {
        "command": "vane.agent.setApiKey",
        "title": "Vane: Set Agent API Key",
        "category": "Vane"
      },
      {
        "command": "vane.agent.clearApiKey",
        "title": "Vane: Clear Agent API Key",
        "category": "Vane"
      },
      {
        "command": "vane.agent.newChat",
        "title": "Vane: New Agent Chat",
        "category": "Vane"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "vane.openAgent" },
        { "command": "vane.openWallets" },
        { "command": "vane.openTransactions" },
        { "command": "vane.showMode" },
        { "command": "vane.agent.setApiKey" },
        { "command": "vane.agent.clearApiKey" },
        { "command": "vane.agent.newChat" }
      ],
      "view/title": [
        {
          "command": "vane.agent.newChat",
          "when": "view == vane.agent",
          "group": "navigation"
        },
        {
          "command": "vane.agent.setApiKey",
          "when": "view == vane.agent",
          "group": "navigation"
        }
      ]
    }
  }
}
