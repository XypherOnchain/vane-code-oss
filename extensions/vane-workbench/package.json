{
  "name": "vane-workbench",
  "displayName": "Vane Workbench",
  "description": "Beginner-first Vane Home, Agent chat, and crypto project overview.",
  "version": "0.3.0",
  "publisher": "vane",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other", "Machine Learning"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension",
  "scripts": {
    "compile": "gulp compile-extension:vane-workbench",
    "watch": "gulp watch-extension:vane-workbench"
  },
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "contributes": {
    "configurationDefaults": {
      "workbench.startupEditor": "none",
      "workbench.tips.enabled": false,
      "workbench.welcomePage.walkthroughs.openOnInstall": false,
      "chat.commandCenter.enabled": false,
      "workbench.secondarySideBar.defaultVisibility": "hidden"
    },
    "configuration": {
      "title": "Vane",
      "properties": {
        "vane.operatingMode": {
          "type": "string",
          "default": "code_only",
          "enum": ["code_only", "simulation", "testnet", "live"],
          "enumDescriptions": [
            "Safe mode - edit and run tools, no chain sends",
            "Simulation only - practice without real money",
            "Testnet - practice network after you approve",
            "Live mainnet - you only; the Agent can never enable this"
          ],
          "description": "How carefully Vane treats money moves. The Agent cannot enable Live."
        },
        "vane.agent.provider": {
          "type": "string",
          "default": "openai",
          "enum": ["openai", "anthropic"],
          "description": "Which AI company powers the Agent (more providers coming)."
        },
        "vane.agent.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Model name (example: gpt-4o-mini, claude-sonnet-4-20250514)."
        },
        "vane.agent.autoRunSafeTools": {
          "type": "boolean",
          "default": true,
          "description": "Auto-run read-only tools. Writes and terminal still ask you first."
        },
        "vane.placeholderChain": {
          "type": "string",
          "default": "Base Sepolia",
          "description": "Network label shown in the status bar (placeholder until wallets)."
        },
        "vane.placeholderWallet": {
          "type": "string",
          "default": "None",
          "description": "Wallet label (shows as No wallet yet when empty)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vane",
          "title": "Vane",
          "icon": "$(rocket)"
        }
      ]
    },
    "views": {
      "vane": [
        {
          "type": "webview",
          "id": "vane.agent",
          "name": "Agent",
          "contextualTitle": "Vane Agent"
        },
        {
          "id": "vane.project",
          "name": "Project",
          "contextualTitle": "Project overview"
        },
        {
          "id": "vane.wallets",
          "name": "Wallets"
        },
        {
          "id": "vane.transactions",
          "name": "Trade"
        }
      ]
    },
    "commands": [
      {
        "command": "vane.openHome",
        "title": "Vane: Open Home",
        "category": "Vane",
        "icon": "$(home)"
      },
      {
        "command": "vane.openAgent",
        "title": "Vane: Open Agent",
        "category": "Vane",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "vane.openProjectOverview",
        "title": "Vane: Project Overview",
        "category": "Vane"
      },
      {
        "command": "vane.refreshProject",
        "title": "Vane: Refresh Project Overview",
        "category": "Vane"
      },
      {
        "command": "vane.openWallets",
        "title": "Vane: Open Wallets",
        "category": "Vane"
      },
      {
        "command": "vane.openTransactions",
        "title": "Vane: Open Trade",
        "category": "Vane"
      },
      {
        "command": "vane.showMode",
        "title": "Vane: Show Operating Mode",
        "category": "Vane"
      },
      {
        "command": "vane.agent.setApiKey",
        "title": "Vane: Set Agent API Key",
        "category": "Vane"
      },
      {
        "command": "vane.agent.clearApiKey",
        "title": "Vane: Clear Agent API Key",
        "category": "Vane"
      },
      {
        "command": "vane.agent.newChat",
        "title": "Vane: New Agent Chat",
        "category": "Vane"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "vane.openHome" },
        { "command": "vane.openAgent" },
        { "command": "vane.openProjectOverview" },
        { "command": "vane.refreshProject" },
        { "command": "vane.openWallets" },
        { "command": "vane.openTransactions" },
        { "command": "vane.showMode" },
        { "command": "vane.agent.setApiKey" },
        { "command": "vane.agent.clearApiKey" },
        { "command": "vane.agent.newChat" }
      ],
      "view/title": [
        {
          "command": "vane.openHome",
          "when": "view == vane.agent || view == vane.project",
          "group": "navigation"
        },
        {
          "command": "vane.agent.newChat",
          "when": "view == vane.agent",
          "group": "navigation"
        },
        {
          "command": "vane.agent.setApiKey",
          "when": "view == vane.agent",
          "group": "navigation"
        },
        {
          "command": "vane.refreshProject",
          "when": "view == vane.project",
          "group": "navigation"
        }
      ]
    }
  }
}
